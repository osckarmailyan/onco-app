NEXT_PUBLIC_SITE_URL=https://www.oncoexperts.ru
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_service_role_key
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=OncoExperts <no-reply@oncoexperts.ru>
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_strong_password

# Keep disabled until migrations, privacy/terms, actual slots and test payment pass review.
BOOKING_ENABLED=false
# Generate at least 32 random characters. Keep stable: changing this invalidates booking links.
BOOKING_TOKEN_SECRET=replace_with_a_long_random_server_only_secret
YOOKASSA_SHOP_ID=replace_with_shop_id
YOOKASSA_SECRET_KEY=replace_with_test_shop_secret
# Must be explicitly true for test shop or false for live shop.
YOOKASSA_TEST_MODE=true
